<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      version="1.4.0.0"
      type="win32"
      name="ShakeToFindCursor"
      processorArchitecture="*" />

  <!--
    asInvoker, not requireAdministrator.

    The highlight overlay needs no privileges at all, so the app is useful to
    everyone; enlarging the *pointer* itself goes through SetSystemCursor,
    which does require admin. The tray menu offers a one-click elevated restart
    and registers a scheduled task for it, instead of demanding a UAC prompt on
    every start (and instead of failing outright when the user says no).
    Build with -DSTFC_REQUIRE_ADMIN=ON to force elevation from the manifest.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Declaring awareness in the manifest (instead of SetProcessDPIAware at
        run time) is what stops the DWM from stretching the whole desktop, which
        is exactly the artifact you would see on a scaled pointer: a blurry
        cursor next to a sharp screen. PerMonitorV2 matters on mixed-DPI
        multi-monitor setups; "system" is the fallback for pre-1703 builds.
      -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, system</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
