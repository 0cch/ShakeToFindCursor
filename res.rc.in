// Generated into the build directory by CMake (see CMakeLists.txt), which
// substitutes absolute paths for the icon and the manifest and picks the
// manifest that matches STFC_REQUIRE_ADMIN. Doing it this way means one source of
// truth for the resources and no reliance on how a particular RC compiler
// resolves relative file names (rc.exe and windres disagree about that).
#include "winres.h"

// IDI_APP_ICON from resource.h, spelled numerically so this file needs no
// include path of its own.
101 ICON "@STFC_ICON_FILE@"

// An embedded manifest is the only reliable place for the DPI awareness and
// OS-support declarations (and it keeps rc.exe and windres in agreement, unlike
// a linker flag). The numeric ids are CREATEPROCESS_MANIFEST_RESOURCE_ID (1)
// and RT_MANIFEST (24); spelled numerically because winres.h pulls those names
// in through winuser.rh, whose contents differ between SDKs.
@STFC_MANIFEST_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "0CCh\0"
            VALUE "FileDescription", "Shake to Find Cursor\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "ShakeToFindCursor\0"
            VALUE "LegalCopyright", "MIT License\0"
            VALUE "OriginalFilename", "ShakeToFindCursor.exe\0"
            VALUE "ProductName", "Shake to Find Cursor\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
